# Environment variables are supplied by the host; this file contains no secrets.
PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Explicit demonstration access; keep false for deployments with real users.
DEMO_MODE=false
DEMO_SEED=false
# Production requires a generated secret of at least 32 characters.
SESSION_SECRET=
# Optional outer presentation gate, >=16 characters; username is presenter.
DEMO_ACCESS_PASSWORD=
# Render sets RENDER=true; proxy defaults to one hop there, zero elsewhere.
# TRUST_PROXY_HOPS=1
# Persist BOTH paths on a durable volume for real data.
# DATA_DIR=/app/.data
# ATTACHMENT_STORAGE_DIR=/app/.karya_storage/attachments
# Optional Gemini extraction. Missing/invalid responses fall back to manual proposals.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
