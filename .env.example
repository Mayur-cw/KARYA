# PORT: HTTP listener; Cloud Run sets PORT automatically
PORT=8080
# NODE_ENV: production|development|test
NODE_ENV=development
# ALLOWED_ORIGINS: comma-separated exact approved frontend origins
ALLOWED_ORIGINS=http://localhost:5173
# DEMO_MODE: true enables local-only demonstrations when explicitly configured
DEMO_MODE=false
# SESSION_SECRET: provision via Secret Manager, never enter a real value in this file
SESSION_SECRET=
# GOOGLE_CLOUD_PROJECT: optional project ID for production Firestore adapter
GOOGLE_CLOUD_PROJECT=
