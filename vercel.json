{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://karya-qtlk.onrender.com/api/:path*" },
    { "source": "/healthz", "destination": "https://karya-qtlk.onrender.com/healthz" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
