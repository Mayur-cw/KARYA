{
  "name": "sop6-function-first-scaffold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run tests/a11y",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && bash scripts/check-repo.sh",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.0.0",
    "cors": "^2.8.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@axe-core/react": "^4.10.2",
    "vitest-axe": "^0.1.0",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "eslint": "^9.34.0",
    "@eslint/js": "^9.34.0",
    "typescript-eslint": "^8.40.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.0",
    "concurrently": "^9.2.0"
  }
}
